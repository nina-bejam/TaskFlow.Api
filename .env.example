# Copy this file to .env before running Docker Compose:
#   cp .env.example .env
#
# All values below are free, local defaults. No paid services required.

# API
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL (Docker service: postgres)
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

# Ollama (Docker service: ollama)
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2

# JWT (custom auth — no Auth0 or cloud identity provider)
JWT_KEY=local-docker-dev-key-change-me-32chars-min
JWT_ISSUER=TaskFlow.Api
JWT_AUDIENCE=TaskFlow.Api

# Local file storage (no S3, Firebase, or cloud blob storage)
FILE_STORAGE_PATH=/app/uploads
